# ---------------------------------------------------------------------------
# SIGOVS — PROJECT CATALOG
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored. NEVER commit a real token.
# ---------------------------------------------------------------------------

# GitHub personal access token, used ONLY by the Node sync scripts.
# It is never bundled into the browser app.
#
# Without a token the sync still works for PUBLIC repositories, but is limited
# to 60 GitHub API requests per hour.
# With a token you get 5000 requests/hour AND your private repositories.
#
# Scopes needed: `repo` (or just `public_repo` if you only want public repos).
# Create one at: https://github.com/settings/tokens
#
# If you have the GitHub CLI installed and authenticated (`gh auth login`),
# you can leave this blank — the sync script falls back to `gh auth token`.
GITHUB_TOKEN=

# GitHub account to build the catalog from.
CATALOG_OWNER=Sigovs

# Extra local folders to scan for cloned repositories (Open in VS Code action).
# Semicolon-separated absolute paths. Optional.
CATALOG_LOCAL_ROOTS=C:\____WORK
